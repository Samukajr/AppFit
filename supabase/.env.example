OPENAI_API_KEY=
# Modelo com suporte a imagens e Structured Outputs.
OPENAI_VISION_MODEL=

# Avaliacoes: Gemini permanece desativado por padrao.
# Somente secrets do servidor; nunca usar EXPO_PUBLIC_ para estas chaves.
GEMINI_API_KEY=
# Escolha um modelo disponivel na sua conta com PDF/imagem e JSON Schema.
GEMINI_MODEL=
GEMINI_REPORTS_ENABLED=false
# Propostas de treino por IA: habilitar separadamente apos revisao do fluxo.
GEMINI_WORKOUTS_ENABLED=false
# Confirmar faturamento ativo no projeto Google e termos de tratamento de dados.
GEMINI_PAID_SERVICE_CONFIRMED=false
# Revisar/publicar politica e consentimento antes de habilitar usuarios reais.
GEMINI_PRIVACY_REVIEWED=false
# Opcional: restringe leitura a um unico UUID de conta durante homologacao.
GEMINI_REPORTS_TEST_USER_ID=
